# Kreatr — environment template
# Copy to .env and fill in. Never commit the filled-in .env.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# AWS / Amazon Bedrock  (model access for the Strands agent)
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1
# Prefer a named profile locally; use IAM roles in deployed environments.
AWS_PROFILE=default
# Only if you are not using a profile or role:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Bedrock model the orchestrator reasons with. Bedrock ids carry a cross-region
# inference-profile prefix (global./us./eu.) ahead of the base model id; switch
# the prefix if `global.` is not enabled for your account.
BEDROCK_MODEL_ID=global.anthropic.claude-opus-5

# ---------------------------------------------------------------------------
# Storage & state
# ---------------------------------------------------------------------------
# S3 bucket for uploaded source video and extracted audio.
S3_BUCKET=kreatr-media-dev

# Creator memory, content, moments, assets and performance rows.
# Use either DynamoDB or Postgres — not both.
DYNAMODB_TABLE=kreatr-state-dev
# DATABASE_URL=postgresql://user:password@localhost:5432/kreatr

# ---------------------------------------------------------------------------
# Transcription
# ---------------------------------------------------------------------------
# One of: aws_transcribe | whisper_local
# aws_transcribe needs S3_BUCKET set and AWS credentials; it has no local deps.
# whisper_local runs offline but needs: pip install faster-whisper
TRANSCRIPTION_PROVIDER=aws_transcribe
# Model size when running Whisper locally: tiny | base | small | medium
WHISPER_MODEL=base
# Path to the ffmpeg binary if it is not on PATH.
# FFMPEG_PATH=/usr/bin/ffmpeg

# ---------------------------------------------------------------------------
# API (FastAPI)
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Web (Next.js)  — NEXT_PUBLIC_* values are exposed to the browser
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Publishing connectors
# ---------------------------------------------------------------------------
# mock  = simulated connector (default for the demo, no OAuth required)
# live  = real platform APIs
PUBLISHING_MODE=mock
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# X_API_KEY=
# X_API_SECRET=

# ---------------------------------------------------------------------------
# Agent behaviour
# ---------------------------------------------------------------------------
# live   — the Strands agent reasons over Bedrock (requires AWS credentials).
# replay — no model calls; runs the same tools against the seeded fixture so the
#          API and UI work offline. A replay run is not the agent deciding.
KREATR_AGENT_MODE=live
# Minimum hook score a candidate moment must reach to survive scoring.
MOMENT_SCORE_THRESHOLD=60
# Confidence below this escalates to the creator instead of auto-planning.
ESCALATION_CONFIDENCE_THRESHOLD=70
# Max tool-call retries before an action is escalated as failed.
MAX_TOOL_RETRIES=3
LOG_LEVEL=INFO
