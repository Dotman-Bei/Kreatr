# Normalise line endings so the repo stays consistent across Windows/macOS/Linux.
* text=auto eol=lf

# Binary assets — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp4 binary
*.mov binary
*.mp3 binary
*.wav binary
*.woff binary
*.woff2 binary

# Keep generated lockfiles out of diff review noise.
package-lock.json linguist-generated=true -diff
