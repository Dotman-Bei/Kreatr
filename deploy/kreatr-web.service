# Kreatr web — the Next.js production server under systemd.
#
# `next start`, not a static export: the workspace pages are async server
# components that fetch the current run at request time. Exporting them would
# freeze whatever run existed at build time into the HTML.
#
# Installed to /etc/systemd/system/kreatr-web.service by deploy/provision.sh.

[Unit]
Description=Kreatr web (Next.js)
# Give up only after five failures inside a minute — that is a real fault (a
# missing build, a claimed port), not a blip worth retrying forever. These two
# belong in [Unit]; systemd ignores them under [Service].
StartLimitIntervalSec=60
StartLimitBurst=5
After=network-online.target kreatr-api.service
Wants=network-online.target

[Service]
Type=exec
WorkingDirectory=/root/kreatr/Kreatr/apps/web
Environment=NODE_ENV=production
Environment=PORT=3010
Environment=HOSTNAME=127.0.0.1

# Server-side render path: the Next.js process talks to the API over loopback,
# skipping DNS, TLS and a round trip back through nginx. The browser-side base
# (NEXT_PUBLIC_API_URL) is inlined at build time instead — see DEPLOY.md.
Environment=KREATR_API_ORIGIN=http://127.0.0.1:8010

ExecStart=/usr/bin/npm run start

# `always`, not `on-failure`: this process has no legitimate reason to exit, and
# on 30 Aug it exited with status 0 — so on-failure ignored it and the site
# served 502s for four days. A clean exit here is still an outage.
Restart=always
RestartSec=5s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=kreatr-web

[Install]
WantedBy=multi-user.target
